{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloBucketsDelPipeline",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::deporte-raw", "arn:aws:s3:::deporte-reportes"]
    },
    {
      "Sid": "LeerEscribirObjetosDelPipeline",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::deporte-raw/*", "arn:aws:s3:::deporte-reportes/*"]
    }
  ]
}
