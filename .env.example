# =====================================================================
# Copia este archivo como .env y completa los valores:  cp .env.example .env
# El archivo .env está en .gitignore: NUNCA lo subas a Git.
# =====================================================================

# --- Airflow ---------------------------------------------------------
AIRFLOW_UID=50000
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia-esta-clave
POSTGRES_PASSWORD=cambia-esta-clave

# --- MinIO (object storage S3-compatible) ----------------------------
# Usuario administrador de MinIO (solo lo usa el contenedor minio-init)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia-esta-clave-larga
# Usuario de mínimo privilegio que usa Airflow (solo lee/escribe sus buckets)
MINIO_AIRFLOW_ACCESS_KEY=airflow-deporte
MINIO_AIRFLOW_SECRET_KEY=cambia-esta-clave-larga-2

# --- SFTP del departamento de rendimiento (archivos GPS) -------------
SFTP_USER=rendimiento
SFTP_PASSWORD=cambia-esta-clave

# --- MySQL heredado de taquilla --------------------------------------
MYSQL_ROOT_PASSWORD=cambia-esta-clave
# Usuario de solo lectura que usa Airflow
MYSQL_READER_USER=airflow_lector
MYSQL_READER_PASSWORD=cambia-esta-clave

# --- API de partidos (football-data.org v4 o el mock local) ----------
# Por defecto apunta al mock local (servicio mock-api). Para la API real:
#   FOOTBALL_API_HOST=https://api.football-data.org  y tu token real.
FOOTBALL_API_HOST=http://mock-api:8000
FOOTBALL_API_TOKEN=token-de-desarrollo-local

# --- Snowflake ---------------------------------------------------------
# Cuenta con el formato <org>-<cuenta> (ej. abcdefg-xy12345)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=DEPORTE_PIPELINE_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DEPORTE_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=DEPORTE_WH
SNOWFLAKE_DATABASE=DEPORTE_DB
SNOWFLAKE_SCHEMA=ANALYTICS
